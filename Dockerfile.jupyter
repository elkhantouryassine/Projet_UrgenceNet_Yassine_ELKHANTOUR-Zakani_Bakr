FROM apache/spark:3.5.7-scala2.12-java17-python3-ubuntu

USER root
RUN python3 -m pip install --no-cache-dir "jupyterlab==4.4.10"
RUN install -d -m 0755 -o spark /home/spark

ENV HOME=/home/spark
ENV SPARK_HOME=/opt/spark
ENV PYTHONPATH=/opt/spark/python:/opt/spark/python/lib/py4j-0.10.9.7-src.zip
ENV PYSPARK_PYTHON=python3

USER spark
WORKDIR /workspace